{
  // El Worker sirve dist/ (lo genera `python src/build.py`) y, sólo en /panel y /api/*,
  // el panel de administración. Ver docs/panel.md.
  "name": "portillo-kus",
  // Cuenta de Cloudflare del estudio (portillokus.estudio@gmail.com). Fijarla evita que un
  // deploy desde una máquina con varias cuentas salga en otra.
  "account_id": "db3b93a7d8b9501a90784cd4f1120e14",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Todo lo demás lo responde la capa de assets, sin ejecutar el Worker.
    "run_worker_first": ["/panel", "/panel/*", "/api/*"]
  },
  // El cliente del panel se sirve como texto: no se ejecuta en el Worker.
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/cliente/*.js", "**/pantallas/*.js"], "fallthrough": true }
  ],
  "vars": {
    "GITHUB_REPO": "WallyAllen/Portillo-Kus",
    "GITHUB_BRANCH": "main"
  },
  // Base del panel en producción (creada el 07/11/2026). Ver docs/panel.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portillo-panel",
      "database_id": "8a549f0c-b5a6-45d4-a124-17954593b32a",
      "migrations_dir": "worker/migrations"
    }
  ],
  // vars y d1_databases no se heredan entre entornos: el Worker de producción (este nivel) no
  // recibe nada de "pruebas" ni de "dev", y viceversa. tests/test_panel_reglas.py lo comprueba.
  "env": {
    // Worker de prueba: `npx wrangler deploy --env pruebas` publica "portillo-kus-pruebas".
    // Escribe en la rama pruebas, nunca en main. Su build lleva NOINDEX=1 (docs/panel.md).
    "pruebas": {
      "vars": {
        "GITHUB_REPO": "WallyAllen/Portillo-Kus",
        "GITHUB_BRANCH": "pruebas"
      },
      // Su propia base, distinta de la de producción (creada el 07/11/2026).
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portillo-panel-pruebas",
          "database_id": "b5ed94f5-d2c4-46f3-ad34-8f8284e33b25",
          "migrations_dir": "worker/migrations"
        }
      ]
    },
    // Sólo para probar en local: npx wrangler@4 dev --env dev
    "dev": {
      "vars": {
        "GITHUB_REPO": "WallyAllen/Portillo-Kus",
        "GITHUB_BRANCH": "main",
        "GITHUB_API_URL": "http://127.0.0.1:8788"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portillo-panel-local",
          "database_id": "solo-local",
          "migrations_dir": "worker/migrations"
        }
      ]
    }
  }
}
